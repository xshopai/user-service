NODE_ENV=development
PORT=8002
SERVICE_NAME=user-service
VERSION=1.0.0

LOG_LEVEL=debug
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/user-service.log

# Messaging Configuration
MESSAGING_PROVIDER=dapr

# Dapr Configuration
DAPR_HOST=localhost
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_ID=user-service
DAPR_PUBSUB_NAME=pubsub

# =============================================================================
# SECRETS ARE IN .dapr/secrets.json (not in this file)
# =============================================================================
# The following are read from Dapr secretstore at runtime:
# - xshopai-cosmos-account-connection (database)
# - xshopai-jwt-secret
# - xshopai-appinsights-connection
# - xshopai-svc-auth-token
# - xshopai-svc-admin-token
# - xshopai-svc-order-token
# - xshopai-svc-webbff-token
# Service Configuration
SERVICE_NAME=user-service
VERSION=1.0.0
PORT=8002
NODE_ENV=development

# Platform Mode
PLATFORM_MODE=dapr

# Dapr sidecar ports (only used in dapr mode)
DAPR_HTTP_PORT=3502
DAPR_GRPC_PORT=50002

# Database Configuration
MONGODB_URI=mongodb://admin:admin123@localhost:27018/user_service_db?authSource=admin
MONGODB_DB_NAME=user_service_db

# Logging
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/user-service.log

# Messaging Configuration
MESSAGING_PROVIDER=dapr
RABBITMQ_URL=amqp://admin:admin123@localhost:5672/
RABBITMQ_EXCHANGE=xshopai.events

# JWT Configuration (for validating tokens from auth-service)
JWT_SECRET=8tDBDMcpxroHoHjXjk8xp/uAn8rzD4y8ZZremFkC4gI=
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
JWT_ISSUER=auth-service
JWT_AUDIENCE=xshopai-platform

# Service Tokens (for validating incoming service-to-service calls)
AUTH_SERVICE_TOKEN=auth_K9pLx3VmT7qRs2Nz8HdWc5Ya1Bj4Fe
ADMIN_SERVICE_TOKEN=adm_P4tQm8LsX2vNr6Yk1HzDc9Bw5Ja3Uf
ORDER_SERVICE_TOKEN=ord_Y7mNx3QaP9tLs2Vk8HdR5cBw1Zj4Fe
WEBBFF_SERVICE_TOKEN=bff_W2rTk8LpQ5nVz1Xm9HsDc4Jy6Fa3Ne

# =============================================================================
# OpenTelemetry Tracing Configuration
# =============================================================================
# Option 1: Zipkin (Local Development)
OTEL_TRACES_EXPORTER=zipkin
OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# Option 2: OTLP (OpenTelemetry Collector)
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Option 3: Azure Application Insights
# OTEL_TRACES_EXPORTER=azure
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://xxx.applicationinsights.azure.com/

OTEL_SERVICE_NAME=user-service
# Service Configuration
SERVICE_NAME=user-service
VERSION=1.0.0
PORT=8002
NODE_ENV=development

# Service Invocation Mode
SERVICE_INVOCATION_MODE=dapr

# Database Configuration (non-secret)
MONGODB_DB_NAME=user_service_db

# Dapr Configuration
DAPR_HTTP_PORT=3502
DAPR_GRPC_PORT=50002

# Logging
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/user-service.log

# Messaging Configuration
MESSAGING_PROVIDER=dapr

# JWT Configuration (non-secret)
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
JWT_ISSUER=auth-service
JWT_AUDIENCE=xshopai-platform